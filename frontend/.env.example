# Copy the settings you need into .env at the repository root.

# ---- The shop (shop/server.py) ----
# The admin's sign-in on the storefront. Without ADMIN_PASSWORD there is no admin.
ADMIN_USERNAME=shop_admin
ADMIN_PASSWORD=your_secure_password_here
# Signs sessions. Leave empty to have one made and kept in the shop's database.
SHOP_SESSION_SECRET=
# Seconds an order stays at each step (placed, packed, shipped, out for delivery).
SHOP_STEP_SECONDS=20
# The shop's PostgreSQL database: postgresql://user:password@host:port/database
# (needs: pip install "psycopg[binary]"). Leave empty to use the SQLite file.
SHOP_DATABASE_URL=
# Where the SQLite file is (default outputs/shop/shop.db), used without SHOP_DATABASE_URL.
SHOP_DB=

# ---- The storefront (frontend/) ----
# Leave empty to reach the shop's server through the Vite proxy.
VITE_API_BASE=
# Where the Vite proxy sends /api (default http://127.0.0.1:8765).
VITE_SCRAPER_WORKER_URL=

# ---- Support desk (optional) ----
# Leave SUPPORT_API_URL empty to switch the whole integration off.
# The shop's server reads these; none of them reaches the browser.
SUPPORT_API_URL=
# Two API keys of the support desk integration, one per job.
# Scope "tickets": shoppers' requests
SUPPORT_API_KEY_WEB=
# Scope "incidents": failed payments and carrier delays, and their recoveries
SUPPORT_API_KEY_EVENTS=
# The signing secret of the webhook that points at <shop>/api/support/webhook
SUPPORT_WEBHOOK_SECRET=
# Signs a signed-in shopper's identity for the chat widget
SUPPORT_CHAT_IDENTITY_SECRET=
# What the support desk's AI sends to call <shop>/api/support/tools/*
SUPPORT_TOOL_TOKEN=
# Where the chat widget is served from (defaults to SUPPORT_API_URL)
SUPPORT_WIDGET_URL=
SUPPORT_INTEGRATION=ethnic-threads

# ---- The scraper (scraper/worker.py; not part of the site any more) ----
ADMIN_EMAIL=your_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_here
# The catalogue is reported as stale when its newest product is older than this
SUPPORT_STALE_HOURS=48
