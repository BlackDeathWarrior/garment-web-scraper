# Frontend Environment Variables
VITE_ADMIN_PASSWORD=your_secure_password_here

# API Configuration
VITE_API_BASE=http://localhost:8765

# Backend Configuration (for scraper/worker.py)
ADMIN_USERNAME=your_admin_username_here
ADMIN_PASSWORD=your_secure_password_here
ADMIN_EMAIL=your_email@example.com

# SMTP Configuration (for OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_app_password_here

# Support desk (optional). Leave SUPPORT_API_URL empty to switch the whole
# integration off: the contact form then uses Formspree as before.
# The worker (scraper/worker.py) reads these; none of them reaches the browser.
SUPPORT_API_URL=
# Two API keys of the support desk integration, one per job.
# Scope "tickets": shopper requests
SUPPORT_API_KEY_WEB=
# Scope "incidents": scraper failures and recoveries
SUPPORT_API_KEY_EVENTS=
# The signing secret of the webhook that points at <worker>/api/support/webhook
SUPPORT_WEBHOOK_SECRET=
# Signs the admin's identity for the chat widget
SUPPORT_CHAT_IDENTITY_SECRET=
# What the support desk's AI sends to call <worker>/api/support/tools/*
SUPPORT_TOOL_TOKEN=
# Where the chat widget is served from (defaults to SUPPORT_API_URL)
SUPPORT_WIDGET_URL=
SUPPORT_INTEGRATION=ethnic-threads
# The catalogue is reported as stale when its newest product is older than this
SUPPORT_STALE_HOURS=48
